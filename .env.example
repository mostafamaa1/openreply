# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
# Optional: when DATABASE_URL goes through a transaction-mode pooler (e.g.
# Supabase port 6543), point prisma migrate at a session-mode URL here.
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=OpenReply <login@example.com>

# Optional: restrict who can sign in. Without it, anyone who reaches your
# public URL can request a magic link and gets their own workspace. Comma
# separated, case insensitive.
# ALLOWED_EMAILS=you@example.com,teammate@example.com

# Optional: use your own SMTP server instead of Resend. When EMAIL_SERVER is
# set it takes over and RESEND_API_KEY is not needed. URL-encode special
# characters in user and password (@ becomes %40).
# EMAIL_SERVER=smtps://login%40example.com:password@mail.example.com:465

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# Content agents. All optional; each agent skips what it lacks.
# Apify reads competitors' public posts. Free plan: $5 credit a month.
# APIFY_TOKEN=apify_api_...
# APIFY_COMPETITOR_POST_LIMIT=30
# Google AI Studio key for the agents' writing (free tier).
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-flash-latest,gemini-3.5-flash-lite
# Time zone for posting times, the calendar and the dashboard's day buckets
# (IANA name). Set it on the worker AND the web app.
# AGENTS_TIMEZONE=UTC
# Weekly run, cron syntax in AGENTS_TIMEZONE (default: Saturday 20:00).
# AGENTS_CRON=0 20 * * 6
# Telegram digest. Create the bot with @BotFather.
# TELEGRAM_BOT_TOKEN=123456:your-bot-token
# Required for the digest: message the bot, then run
# `npm run agents -- telegram-chat` to find your chat id.
# TELEGRAM_CHAT_ID=
# Which workspace's digest goes to that chat. Optional when only one
# workspace has a content profile; with several and none set, no digest is sent.
# The `npm run agents` CLI needs it when more than one workspace has a
# connected Instagram account.
# AGENTS_WORKSPACE_ID=
